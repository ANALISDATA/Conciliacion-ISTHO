# Copia este archivo a .streamlit/secrets.toml (ese sí está excluido de Git) y
# rellena los valores reales. En Railway, estas mismas claves van en Variables
# de entorno, no en un archivo.

# --- Datos de la empresa (ya existentes) ---
empresa = "ISTHO S.A.S."
nit = "000.000.000-0"
cuenta = "Cuenta bancaria"
password = ""

# --- Supabase: para no perder el trabajo si el servidor se reinicia ---
# Dashboard de Supabase → tu proyecto → Project Settings → API
#   supabase_url = "Project URL"
#   supabase_key = "service_role" (NO la "anon"/"public" — esta debe quedar secreta,
#                  nunca se expone al navegador porque solo la usa el servidor)
supabase_url = "https://xxxxxxxxxxxx.supabase.co"
supabase_key = "eyJhbGciOi..."
